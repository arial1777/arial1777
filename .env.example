# 本番の公開URL。canonical / OGP / sitemap の生成元になるので、デプロイ先で必ず設定する。
# 空のまま置くと設定していないのと同じ扱いになる（Vercel なら本番ドメイン、
# それ以外は http://localhost:3000 が使われる）。スキームから書く。
NEXT_PUBLIC_SITE_URL=https://example.com

# 管理画面（/admin/songs）のベーシック認証。両方そろっていないと管理画面は開かない。
ADMIN_USER=arial
ADMIN_PASSWORD=

# 曲データの保存先。Vercel のダッシュボードで Blob ストアを作ってプロジェクトに
# つなぐと自動で入る。未設定のあいだは data/songs.json に保存される（手元用）。
# BLOB_READ_WRITE_TOKEN=
